for(var i = 0; i < op_length_y; i++) {
	var text_color = selected_replay.replay_input[0].stage_played[i]
	scribble_object[i] = scribble(option[i][0])
		.starting_format("drp_shd",make_color_rgb(127 + (128 * text_color),127 + (128 * text_color),127 + (128 * text_color)))
		.align(fa_left,fa_top)
		.wrap(640)
		.draw(280,64 + (op_space * i))
	scribble_object[i + op_length_y] = scribble(option[i][1])
		.starting_format("drp_shd",make_color_rgb(127 + (128 * text_color),127 + (128 * text_color),127 + (128 * text_color)))
		.align(fa_right,fa_top)
		.wrap(640)
		.draw(360,64 + (op_space * i))
}
